# Porta HTTP/WebSocket do backend
PORT=3001

# PostgreSQL + PostGIS (porta 5544 no host via Docker — ver docker-compose.yml)
DATABASE_URL=postgres://volta:volta@localhost:5544/volta_ao_lago
# Em banco gerenciado (Supabase/Neon), use DATABASE_SSL=true
# DATABASE_SSL=true
# Validação REAL do certificado (recomendado em produção): cole o CA em PEM
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----..."
# ...ou aponte para um arquivo:
# DATABASE_CA_FILE=./supabase-ca.pem

# Redis (Pub/Sub + cache GEO). Se ausente/indisponível, o backend roda em modo
# memória (instância única) — útil para desenvolvimento sem Docker.
REDIS_URL=redis://localhost:6380

# Segredo JWT. OBRIGATÓRIO em produção (NODE_ENV=production recusa subir sem).
JWT_SECRET=dev-secret-volta-ao-lago

# Distância (m) para disparar alerta de aproximação de PC
GEOFENCE_RADIUS_M=350

# Origens permitidas no CORS (separe por vírgula). * = libera tudo (dev).
CORS_ORIGIN=*

# Content-Security-Policy: configurada por padrão. Se algum recurso do mapa
# quebrar no deploy, desligue com HELMET_CSP=off e reporte.
# HELMET_CSP=off

# Retenção do rastro (position_logs) em dias. Sem valor = mantém tudo.
# POSITION_LOGS_RETENTION_DAYS=14

# Migração automática no boot (schema + functions, idempotente; seed só em
# base vazia). Ligada por padrão — desligue se preferir migrar manualmente.
# AUTO_MIGRATE=off

# Login SEM senha (1 toque na torre e no celular do co-piloto). Ligado por
# padrão a pedido da organização. OPEN_LOGIN=off volta a exigir senha em tudo.
# OPEN_LOGIN=off

# Fuso horário dos CSVs de exportação (padrão America/Sao_Paulo).
# RACE_TIMEZONE=America/Sao_Paulo
